---
layout: base.njk
title: Curriculum Vitae
lang: en
permalink: /en/cv/
---
<span class="kicker">Background</span>
<h1>Curriculum Vitae</h1>
<p class="lede">
  Academic education and skills. My teaching experience is listed in the "Teaching" section and my research experience in the "Research" section.
</p>

<h2>Education & Degrees</h2>
{% for edu in site.education %}
<div class="card">
  <span class="card__label">{{ edu.years }}</span>
  <h3>{{ edu.title_en }}</h3>
  <p><strong>Institution:</strong> {{ edu.institution }}
  {% if edu.institution == "INSA de Lyon" %}
      <img src="/images/logo-insa.png" alt="INSA de Lyon logo" style="height: 18px; vertical-align: middle; margin-left: 0.4rem; opacity: 0.7;">
    {% endif %}
    {% if edu.institution == "École Normale Supérieure de Lyon" %}
      <img src="/images/logo_ens.png" alt="ENS de Lyon logo" style="height: 18px; vertical-align: middle; margin-left: 0.4rem; opacity: 0.7;">
    {% endif %}
    {% if edu.institution == "Université de Strasbourg" %}
      <img src="/images/logo_strasbourg.png" alt="University of Strasbourg logo" style="height: 18px; vertical-align: middle; margin-left: 0.4rem; opacity: 0.7;">
    {% endif %}
    {% if edu.institution == "Lycée Carnot (Dijon)" %}
      <img src="/images/logo_carnot.png" alt="Lycée Carnot logo" style="height: 18px; vertical-align: middle; margin-left: 0.4rem; opacity: 0.7;">
    {% endif %}
  </p>
  {% if edu.details_en %}<p style="margin-top: 0.2rem; color: var(--pink-deep); font-weight: 700;">{{ edu.details_en }}</p>{% endif %}
</div>
{% endfor %}

<h2>Skills & Languages</h2>
<div class="card">
  <span class="card__label">Programming & Scientific Computing</span>
  <p>{{ site.skills.programming }}</p>
</div>
<div class="card">
  <span class="card__label">Languages</span>
  <p>{{ site.skills.languages.en }}</p>
</div>
