---
layout: false
permalink: /notes/ie1/index.html
title: Consulter ma note
eleventyExcludeFromCollections: true
---
<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<meta name="referrer" content="no-referrer">
<title>{{ title }}</title>
<style>
:root{--bg:#f6f7fb;--card:#fff;--tx:#1d2433;--mu:#69728a;--ac:#4f46e5;--bd:#e3e6ef;--ok:#16a34a;--ko:#dc2626;color-scheme:light dark}
@media(prefers-color-scheme:dark){:root{--bg:#12141c;--card:#1b1e2a;--tx:#e8eaf2;--mu:#98a0b8;--ac:#818cf8;--bd:#2b3042;--ok:#4ade80;--ko:#f87171}}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--tx);font:16px/1.5 system-ui,sans-serif;padding:1rem}
main{max-width:860px;margin:0 auto}
.card{background:var(--card);border:1px solid var(--bd);border-radius:14px;padding:1.2rem;margin:1rem 0}
h1{font-size:1.5rem;margin:.5rem 0}h2{font-size:1.1rem;margin:0 0 .6rem}
.mu{color:var(--mu);font-size:.9rem}
form{display:grid;gap:.8rem;max-width:380px}
label{display:grid;gap:.25rem;font-weight:600;font-size:.9rem}
input{padding:.6rem .7rem;border:1px solid var(--bd);border-radius:8px;background:var(--bg);color:var(--tx);font:inherit}
button{padding:.65rem 1rem;border:0;border-radius:8px;background:var(--ac);color:#fff;font:inherit;font-weight:600;cursor:pointer}
button.sec{background:none;color:var(--ac);border:1px solid var(--ac)}
button:disabled{opacity:.6;cursor:wait}
#err{color:var(--ko);min-height:1.4em;margin:0}
.kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:.8rem}
.kpi{border:1px solid var(--bd);border-radius:12px;padding:.8rem;text-align:center}
.kpi b{display:block;font-size:1.7rem;line-height:1.2}.kpi.big b{font-size:2.4rem;color:var(--ac)}
.kpi small{color:var(--mu)}
.hist{display:flex;align-items:flex-end;gap:4px;height:110px;margin-top:.5rem}
.hist div{flex:1;text-align:center;font-size:.7rem;color:var(--mu);display:flex;flex-direction:column;justify-content:flex-end;height:100%}
.hist i{display:block;background:var(--bd);border-radius:4px 4px 0 0;min-height:2px}
.hist .me i{background:var(--ac)}.hist .me{color:var(--ac);font-weight:700}
.scroll{overflow-x:auto}
table{width:100%;border-collapse:collapse;font-size:.92rem}
th,td{padding:.45rem .5rem;text-align:right;border-bottom:1px solid var(--bd);white-space:nowrap}
th:first-child,td:first-child{text-align:left}th{color:var(--mu);font-weight:600;font-size:.8rem}
.bar{position:relative;height:10px;background:var(--bd);border-radius:5px;min-width:90px}
.bar i{position:absolute;inset:0 auto 0 0;background:var(--ac);border-radius:5px}
.bar b{position:absolute;top:-3px;bottom:-3px;width:3px;background:var(--tx);border-radius:2px}
.exh{display:flex;justify-content:space-between;flex-wrap:wrap;gap:.3rem;align-items:baseline}
.up{color:var(--ok)}.down{color:var(--ko)}
[hidden]{display:none!important}
</style>
</head>
<body>
<main>
<h1 id="titre"></h1>
<p class="mu" id="sous"></p>

<section class="card" id="login">
  <h2>Accéder à mes résultats</h2>
  <form id="f" autocomplete="off">
    <label>Numéro étudiant·e
      <input id="num" inputmode="numeric" pattern="[0-9]{6,10}" required>
    </label>
    <label id="lcode">Code personnel
      <input id="code" autocapitalize="characters" placeholder="XXXX-XXXX" spellcheck="false">
    </label>
    <button id="go">Consulter</button>
    <p id="err" role="alert"></p>
  </form>
  <p class="mu">Vos résultats sont chiffrés&nbsp;: ils sont déchiffrés localement dans votre navigateur et ne sont jamais envoyés ailleurs.</p>
</section>

<div id="res" hidden></div>
</main>

<script type="application/json" id="d">{{ notesIE1 | dump | safe }}</script>
{% raw %}
<script>
const D = JSON.parse(document.getElementById('d').textContent);
const $ = id => document.getElementById(id);
const enc = new TextEncoder();
const b64 = s => Uint8Array.from(atob(s), c => c.charCodeAt(0));
const hex = b => [...new Uint8Array(b)].map(x => x.toString(16).padStart(2, '0')).join('');
const f2 = n => n.toLocaleString('fr-FR', {minimumFractionDigits: 2, maximumFractionDigits: 2});
const fs = n => n.toLocaleString('fr-FR', {maximumFractionDigits: 2});
const pct = (a, m) => Math.max(0, Math.min(100, a / m * 100));

$('titre').textContent = D.titre;
$('sous').textContent = (D.date ? new Date(D.date).toLocaleDateString('fr-FR', {dateStyle: 'long'}) + ' · ' : '') + D.effectif + ' copies';
$('lcode').hidden = !D.avecCode;
let timer;

async function derive(pw, salt, usage) {
  const base = await crypto.subtle.importKey('raw', enc.encode(pw), 'PBKDF2', false, ['deriveKey']);
  return crypto.subtle.deriveKey({name: 'PBKDF2', salt, iterations: D.iter, hash: 'SHA-256'}, base,
    {name: 'AES-GCM', length: 256}, false, usage);
}

async function ouvrir(num, code) {
  const tag = hex(await crypto.subtle.digest('SHA-256', enc.encode(D.tagSalt + num))).slice(0, 8);
  const cands = D.eleves.filter(e => e.tag === tag);
  if (!cands.length) await derive('x', new Uint8Array(16), ['decrypt']); // même durée si numéro inconnu
  for (const e of cands) {
    try {
      const key = await derive(num + ':' + code, b64(e.salt), ['decrypt']);
      const pt = await crypto.subtle.decrypt({name: 'AES-GCM', iv: b64(e.iv)}, key, b64(e.ct));
      return JSON.parse(new TextDecoder().decode(pt));
    } catch {}
  }
  return null;
}

$('f').addEventListener('submit', async ev => {
  ev.preventDefault();
  $('err').textContent = ''; $('go').disabled = true; $('go').textContent = 'Vérification…';
  const num = $('num').value.trim();
  const code = D.avecCode ? $('code').value.toUpperCase().replace(/[^A-Z0-9]/g, '') : '';
  let r = null;
  try { r = await ouvrir(num, code); } catch (e) { $('err').textContent = 'Navigateur non compatible (HTTPS requis).'; }
  $('go').disabled = false; $('go').textContent = 'Consulter';
  if (!r) { if (!$('err').textContent) $('err').textContent = 'Identifiants incorrects.'; return; }
  $('f').reset(); $('login').hidden = true;
  afficher(r);
  clearTimeout(timer); timer = setTimeout(quitter, 10 * 60 * 1000);
});

function quitter() { $('res').hidden = true; $('res').innerHTML = ''; $('login').hidden = false; }

function afficher(r) {
  const g = D.global, delta = r.note - g.mean;
  const kpi = (v, l, c = '') => `<div class="kpi ${c}"><b>${v}</b><small>${l}</small></div>`;
  const maxH = Math.max(...g.hist), bin = Math.min(9, Math.floor(r.note / 2));
  const hist = g.hist.map((n, i) => `<div class="${i === bin ? 'me' : ''}" title="${n} copie(s)">${n}<i style="height:${n / maxH * 80}px"></i>${2 * i}–${2 * i + 2}</div>`).join('');

  let h = `<section class="card"><div class="kpis">
    ${kpi(f2(r.note) + ' <small>/ 20</small>', 'Ma note', 'big')}
    ${kpi(f2(g.mean), 'Moyenne du groupe')}
    ${kpi(f2(g.median), 'Médiane')}
    </div>
  
    <h2>Répartition des notes</h2><div class="hist">${hist}</div></section>`;

  for (const ex of D.exercices) {
    const tot = D.questions.reduce((a, q, i) => a + (q.ex === ex.ex ? r.items[i].p : 0), 0);
    h += `<section class="card"><div class="exh"><h2>Exercice ${ex.ex}</h2>
      <span><b>${f2(tot)}</b> / ${fs(ex.max)} <span class="mu">· moyenne ${f2(ex.mean)} · médiane ${f2(ex.median)}</span></span></div>
      <div class="scroll"><table><thead><tr><th>Question</th><th>Note</th><th>Points</th><th>Moi vs moyenne</th><th>Moy.</th><th>Méd.</th></tr></thead><tbody>`;
    D.questions.forEach((q, i) => {
      if (q.ex !== ex.ex) return;
      const it = r.items[i];
      h += `<tr><td>${q.id}</td><td>${it.s === null ? '<span class="mu" title="Non traitée">—</span>' : fs(it.s) + '/4'}</td>
        <td>${f2(it.p)} / ${fs(q.max)}</td>
        <td><div class="bar" title="Trait noir : moyenne de la classe"><i style="width:${pct(it.p, q.max)}%"></i><b style="left:calc(${pct(q.mean, q.max)}% - 1px)"></b></div></td>
        <td>${f2(q.mean)}</td><td>${f2(q.median)}</td></tr>`;
    });
    h += '</tbody></table></div></section>';
  }
  h += '<p><button class="sec" id="out">Me déconnecter</button></p>';
  $('res').innerHTML = h; $('res').hidden = false;
  $('out').onclick = quitter;
  scrollTo(0, 0);
}
</script>
{% endraw %}
</body>
</html>
